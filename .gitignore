# Unity .gitignore
# Recommended for Unity projects. Place this file at the root of the repository.
# Keeps source (Assets/, ProjectSettings/, Packages/) tracked and ignores local/derived files.

### OS generated files ###
.DS_Store
Thumbs.db

### Unity generated folders ###
# Unity generated directories
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
/sysinfo.txt

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Recordings
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv


### Visual Studio / Rider / VSCode ###
/.vs/
.vscode/
.idea/

*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

### User-specific files ###
*.swp
*.bak
*.backup
LocalSettings/
UserSettings/

### Build results ###
*.apk
*.aab
*.unitypackage
*.app
*.xcodeproj

### Native / plugin binaries (often rebuilt) ###
*.so
*.dll
*.dylib
*.lib

### Logs and crash reports ###
crash.log
crashes/

### Package manager / lock files (optional) ###
# You may want to keep lock files in source control depending on your workflow.
# Uncomment to ignore npm/yarn lock files if you prefer not to commit them.
# package-lock.json
# yarn.lock

# IMPORTANTE: Archivos que SÍ deben estar en Git
# Los archivos .asset en Assets/ y ProjectSettings/ SÍ deben estar en control de versiones
!/[Aa]ssets/**
!/[Pp]roject[Ss]ettings/**
!/[Pp]ackages/**
!**/*.meta

# Pero ignoramos archivos generados automáticamente
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/[Ss]treamingAssets/**/*.bank
/[Aa]ssets/[Ss]treamingAssets/**/*.bank.meta
# Ignore all TextMesh Pro files
[Aa]ssets/TextMesh\ Pro/
[Aa]ssets/TextMesh\ Pro.meta
*.DotSettings

# Ignore JetBrains Rider workspace files
.idea/

# End of .gitignore
